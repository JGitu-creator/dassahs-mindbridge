{
  "manifest_version": 3,
  "name": "Dassah's Prism - Neural Bridge",
  "version": "1.1",
  "description": "Refract overwhelming noise into divine clarity.",
  "permissions": ["activeTab", "scripting", "contextMenus", "notifications"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "host_permissions": [
    "https://dassahs-mindbridge-rjeiohdc3-phidotaxis-3372s-projects.vercel.app/*",
    "http://localhost:3000/*"
  ]
}